        try:
            muted = "[MUTED]" in run_command("wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@")
            mute.set_label("Unmute" if muted else "Mute")
        except (OSError, subprocess.SubprocessError, RuntimeError) as error:
            notify_error("Volume control", error)
        mute.connect("clicked", toggle_mute)

    current = {"value": value, "source": 0}

    def apply_pending():
        current["source"] = 0
        try:
            apply_slider_value(kind, current["value"])
        except (OSError, subprocess.SubprocessError, RuntimeError) as error:
            notify_error(f"{title_text} control", error)
        return GLib.SOURCE_REMOVE

    def set_value(value):
        current["value"] = max(0, min(100, round(value)))
        value_label.set_text(f"{current['value']}%")
        slider.queue_draw()
        if current["source"]:
            GLib.source_remove(current["source"])
        current["source"] = GLib.timeout_add(80, apply_pending)

    def draw_slider(widget, context):
        allocation = widget.get_allocation()
        start = 12
        end = max(start + 1, allocation.width - 12)
        center_y = allocation.height / 2
        knob_x = start + (end - start) * current["value"] / 100

        context.set_line_cap(cairo.LINE_CAP_ROUND)
        context.set_line_width(6)
        context.set_source_rgb(0.20, 0.20, 0.20)
        context.move_to(start, center_y)
        context.line_to(end, center_y)
        context.stroke()

        context.set_source_rgb(0.88, 0.88, 0.88)
        context.move_to(start, center_y)
        context.line_to(knob_x, center_y)
        context.stroke()

        context.arc(knob_x, center_y, 8, 0, 2 * 3.141592653589793)
        context.set_source_rgb(0.95, 0.95, 0.95)
        context.fill_preserve()
        context.set_line_width(2)
        context.set_source_rgb(0.08, 0.08, 0.08)
        context.stroke()
        return False

    def set_from_pointer(event):
        width = slider.get_allocated_width()
        start = 12
        end = max(start + 1, width - 12)
        set_value((event.x - start) / (end - start) * 100)

    def button_press(_widget, event):
        if event.button == 1:
            slider.grab_focus()
            set_from_pointer(event)
            return True
        return False

    def pointer_motion(_widget, event):
        if event.state & Gdk.ModifierType.BUTTON1_MASK:
            set_from_pointer(event)
            return True
        return False

    def key_press(_widget, event):
        step = 5 if event.state & Gdk.ModifierType.SHIFT_MASK else 1
        if event.keyval == Gdk.KEY_Left:
            set_value(current["value"] - step)
            return True
        if event.keyval == Gdk.KEY_Right:
            set_value(current["value"] + step)
            return True
        if event.keyval == Gdk.KEY_Home:
            set_value(0)
            return True
        if event.keyval == Gdk.KEY_End:
            set_value(100)
            return True
        return False

    slider.connect("draw", draw_slider)
    slider.connect("button-press-event", button_press)
    slider.connect("motion-notify-event", pointer_motion)
    slider.connect("key-press-event", key_press)
    window.show_all()
    slider.grab_focus()
    Gtk.main()


def main():
    modes = {
        "quick-settings": show_quick_settings,
        "screenshot-full": lambda: capture_screenshot(False),
        "screenshot-area": lambda: capture_screenshot(True),
        "calendar": show_calendar,
        "wifi": show_wifi,
        "bluetooth": show_bluetooth,
        "volume": lambda: show_slider("volume"),
        "brightness": lambda: show_slider("brightness"),
    }
    if len(sys.argv) != 2 or sys.argv[1] not in modes:
        print(f"Usage: {sys.argv[0]} {{{'|'.join(modes)}}}", file=sys.stderr)
        return 2

    install_style()
    signal.signal(signal.SIGINT, handle_termination)
    signal.signal(signal.SIGTERM, handle_termination)
    disable_hover_focus()
    try:
        modes[sys.argv[1]]()
    finally:
        restore_hover_focus()
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, RuntimeError, subprocess.SubprocessError) as error:
        notify_error("Waybar control", error)
        raise
