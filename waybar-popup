    def refresh_battery():
        try:
            supplies = [
                path for path in os.listdir("/sys/class/power_supply")
                if path.startswith("BAT")
            ]
            if not supplies:
                battery_label.set_text("Battery: not available")
                return GLib.SOURCE_CONTINUE
            battery_path = os.path.join("/sys/class/power_supply", supplies[0])
            with open(os.path.join(battery_path, "capacity"), encoding="utf-8") as file:
                capacity = int(file.read().strip())
            status_path = os.path.join(battery_path, "status")
