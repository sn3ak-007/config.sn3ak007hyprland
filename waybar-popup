def make_window(title, width):
    window = Gtk.Window()
    window.set_title(title)
    window.set_default_size(width, -1)
    window.set_resizable(False)
    window.set_decorated(False)
    window.set_skip_taskbar_hint(True)
    window.set_skip_pager_hint(True)
    window.connect("key-press-event", on_key_press)
    window.connect("focus-out-event", close_on_focus_loss)
    configure_layer_shell(window)

    card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
    card.get_style_context().add_class("popup-card")
    window.add(card)
    return window, card


def close_on_focus_loss(_window, _event):
    GLib.idle_add(Gtk.main_quit)
    return False


def add_header(card, title_text):
    row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
