    def update_network_and_vpn():
        def check():
            try:
                wifi = run_command(
                    "nmcli", "-t", "--escape", "no", "-f", "IN-USE,SSID",
                    "device", "wifi", "list", "--rescan", "no",
                )
                ssid = next(
                    (line[2:] for line in wifi.splitlines() if line.startswith("*:")),
                    "",
                )
                radio = run_command("nmcli", "-t", "-f", "WIFI", "radio")
                wifi_text = (
                    f"Wi-Fi: {ssid}" if ssid else
                    "Wi-Fi: not connected" if radio == "enabled" else
                    "Wi-Fi: off"
                )
            except (OSError, subprocess.SubprocessError, RuntimeError) as error:
                wifi_text = f"Wi-Fi: unavailable ({error})"

            try:
                result = subprocess.run(
                    [EDUVPN_CLI, "status"],
                    check=False,
                    capture_output=True,
                    text=True,
                    timeout=8,
                )
                output = f"{result.stdout}\n{result.stderr}".casefold()
                if "connected to:" in output:
                    vpn_connected = True
                elif (
                    "you are currently not connected to a server" in output
                    or "you are not connected to a server" in output
                ):
                    vpn_connected = False
                else:
                    raise RuntimeError(
                        f"Unexpected eduVPN status (exit code {result.returncode})"
                    )
                vpn_error = None
            except (OSError, subprocess.SubprocessError, RuntimeError) as error:
                vpn_connected = None
                vpn_error = str(error)

            def apply():
                network_status.set_text(wifi_text)
                if vpn_error:
                    vpn_status.set_text("eduVPN: status unavailable")
                    vpn_button.set_label("Open eduVPN")
                    vpn_button.set_sensitive(True)
                    vpn_state["connected"] = False
                else:
                    vpn_state["connected"] = bool(vpn_connected)
                    vpn_status.set_text(
                        "eduVPN: connected" if vpn_connected else "eduVPN: disconnected"
                    )
                    vpn_button.set_label(
                        "Disconnect" if vpn_connected else "Connect"
                    )
                    vpn_button.set_sensitive(True)
                return GLib.SOURCE_REMOVE

            GLib.idle_add(apply)

        threading.Thread(target=check, daemon=True).start()
        return GLib.SOURCE_CONTINUE

    vpn_state = {"connected": False}

    def on_vpn_status_changed(*_args):
        vpn_state["connected"] = vpn_status.get_text() == "eduVPN: connected"

    vpn_status.connect("notify::label", on_vpn_status_changed)

    def toggle_vpn(_button):
        vpn_button.set_sensitive(False)
        try:
            if vpn_state["connected"]:
                result = subprocess.run(
                    [EDUVPN_CLI, "disconnect"],
                    check=False,
                    capture_output=True,
                    text=True,
                    timeout=30,
                )
                if result.returncode != 0:
                    raise RuntimeError(
                        f"eduVPN disconnect failed (exit code {result.returncode})"
                    )
                update_network_and_vpn()
            else:
                subprocess.Popen([EDUVPN_GUI])
                Gtk.main_quit()
        except (OSError, subprocess.SubprocessError, RuntimeError) as error:
            vpn_button.set_sensitive(True)
            notify_error("eduVPN", error)

