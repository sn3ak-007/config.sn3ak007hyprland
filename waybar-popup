def run_command(*args, timeout=3):
    return subprocess.run(
        args,
        check=True,
        capture_output=True,
        text=True,
        timeout=timeout,
    ).stdout.strip()


def disable_hover_focus():
    global _original_follow_mouse

    output = run_command("hyprctl", "getoption", "input:follow_mouse")
    match = re.search(r"int:\s*(-?\d+)", output)
    if not match:
        raise RuntimeError(f"Could not read Hyprland mouse-focus setting: {output}")

    _original_follow_mouse = match.group(1)
    run_command("hyprctl", "eval", "hl.config({ input = { follow_mouse = 0 } })")


def restore_hover_focus():
    global _original_follow_mouse

    if _original_follow_mouse is None:
        return

    value = _original_follow_mouse
    _original_follow_mouse = None
    run_command("hyprctl", "eval", f"hl.config({{ input = {{ follow_mouse = {value} }} }})")


atexit.register(restore_hover_focus)


def handle_termination(_signum, _frame):
    restore_hover_focus()
    Gtk.main_quit()


def notify_error(title, error):
    message = str(error).strip() or "The command failed."
    subprocess.run(
        ["notify-send", "--urgency=critical", "--app-name=Waybar", title, message],
        check=False,
    )


def load_slider_value(kind):
    if kind == "volume":
        output = run_command("wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@")
        match = re.search(r"Volume:\s*([0-9.]+)", output)
        if not match:
            raise RuntimeError(f"Could not read audio volume: {output}")
        return min(100, round(float(match.group(1)) * 100))

    output = run_command("brightnessctl", "-m")
    fields = output.splitlines()[0].split(",")
    if len(fields) < 4 or not fields[3].endswith("%"):
        raise RuntimeError(f"Could not read screen brightness: {output}")
    return int(fields[3].rstrip("%"))


def apply_slider_value(kind, value):
    if kind == "volume":
        run_command("wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", f"{value / 100:.2f}")
    else:
        run_command("brightnessctl", "set", f"{value}%")


def active_wifi_name():
    output = run_command(
        "nmcli",
        "-t",
        "--escape",
        "no",
        "-f",
        "IN-USE,SSID",
        "device",
        "wifi",
        "list",
        "--rescan",
        "no",
    )
    for line in output.splitlines():
        if line.startswith("*:"):
            return line[2:]
    return ""


def configure_layer_shell(window, centered=False):
    library_path = ctypes.util.find_library("gtk-layer-shell")
    if not library_path:
        raise RuntimeError("libgtk-layer-shell is not installed")

    library = ctypes.CDLL(library_path)
    pointer = ctypes.c_void_p(hash(window))
    library.gtk_layer_init_for_window.argtypes = [ctypes.c_void_p]
    library.gtk_layer_set_layer.argtypes = [ctypes.c_void_p, ctypes.c_int]
    library.gtk_layer_set_anchor.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_bool]
    library.gtk_layer_set_margin.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_int]
    library.gtk_layer_set_keyboard_mode.argtypes = [ctypes.c_void_p, ctypes.c_int]
    library.gtk_layer_set_namespace.argtypes = [ctypes.c_void_p, ctypes.c_char_p]

    library.gtk_layer_init_for_window(pointer)
    library.gtk_layer_set_layer(pointer, 3)
    if centered:
        library.gtk_layer_set_anchor(pointer, 0, True)
        library.gtk_layer_set_anchor(pointer, 2, True)
        monitor = Gdk.Display.get_default().get_monitor(0)
        if monitor is None:
            raise RuntimeError("No display is available for the quick-settings panel")
        geometry = monitor.get_geometry()
        library.gtk_layer_set_margin(pointer, 2, 46)
        library.gtk_layer_set_margin(pointer, 0, max(0, (geometry.width - 420) // 2))
    else:
        library.gtk_layer_set_anchor(pointer, 2, True)
        library.gtk_layer_set_anchor(pointer, 1, True)
        library.gtk_layer_set_margin(pointer, 2, 8)
        library.gtk_layer_set_margin(pointer, 1, 12)
    library.gtk_layer_set_keyboard_mode(pointer, 2)
    namespace = b"waybar-quick-settings" if centered else b"waybar-control-popup"
    library.gtk_layer_set_namespace(pointer, namespace)


