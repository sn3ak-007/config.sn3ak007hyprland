#!/usr/bin/env python3

import json
import math
import os
import re
import shutil
import socket
import subprocess
import threading

HYPRCTL = shutil.which("hyprctl") or "hyprctl"
OPEN_WINDOW = re.compile(r"^openwindow>>(?P<address>(?:0x)?[0-9a-fA-F]+),")


def hyprctl_json(*args):
    result = subprocess.run(
        [HYPRCTL, "-j", *args],
        check=True,
        capture_output=True,
        text=True,
        timeout=3,
    )
    return json.loads(result.stdout)


def css_horizontal_gaps(value):
    parts = [int(part) for part in value.split()]
    if len(parts) == 1:
        return parts[0] * 2
    if len(parts) == 2:
        return parts[1] * 2
    if len(parts) == 4:
        return parts[1] + parts[3]
    raise ValueError(f"Unexpected general:gaps_out value: {value}")


def snap_window(address):
    clients = hyprctl_json("clients")
    client = next((item for item in clients if item.get("address") == address), None)
    if client is None or client.get("floating") or client.get("fullscreen"):
        return

    workspace_clients = [
        item
        for item in clients
        if item.get("workspace", {}).get("id") == client.get("workspace", {}).get("id")
        and not item.get("floating")
        and not item.get("fullscreen")
    ]
    if len(workspace_clients) == 2:
        return

    monitors = hyprctl_json("monitors")
    monitor_index = client.get("monitor")
    monitor = next(
        (item for item in monitors if item.get("id") == monitor_index),
        None,
    )
    if monitor is None:
        return

    gaps = hyprctl_json("getoption", "general:gaps_out")["css"]
    border = hyprctl_json("getoption", "general:border_size")["int"]
    reserved = monitor.get("reserved", [0, 0, 0, 0])
    usable_width = (
        monitor["width"]
        - reserved[0]
        - reserved[2]
        - css_horizontal_gaps(gaps)
    )
    if usable_width <= 0:
        return

    current_width, current_height = client["size"]
    outer_width = current_width + 2 * border
    current_percent = outer_width * 100 / usable_width
    snapped_percent = min(100, max(10, math.floor(current_percent / 10 + 0.5) * 10))
    target_width = max(1, round(usable_width * snapped_percent / 100) - 2 * border)
    if target_width == current_width:
        return

    lua = (
        "hl.dispatch(hl.dsp.window.resize({ "
        f"x = {target_width}, y = {current_height}, relative = false, "
        f'window = "address:{address}"'
        " }))"
    )
    subprocess.run(
        [HYPRCTL, "eval", lua],
        check=True,
        capture_output=True,
        text=True,
        timeout=3,
    )


def handle_event(line):
    match = OPEN_WINDOW.match(line)
    if not match:
        return

    address = match.group("address")
    if not address.startswith("0x"):
        address = f"0x{address}"
    timer = threading.Timer(0.25, apply_snap, args=(address,))
    timer.daemon = True
    timer.start()


def apply_snap(address):
    try:
        snap_window(address)
    except (OSError, subprocess.SubprocessError, ValueError, KeyError) as error:
        print(f"hypr-window-snap: {error}", flush=True)


def main():
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR")
    instance = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    if not runtime_dir or not instance:
        raise RuntimeError("Hyprland runtime environment is missing")

    socket_path = os.path.join(runtime_dir, "hypr", instance, ".socket2.sock")
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.connect(socket_path)
        buffer = b""
        while True:
            chunk = connection.recv(4096)
            if not chunk:
                return
            buffer += chunk
            while b"\n" in buffer:
                line, buffer = buffer.split(b"\n", 1)
                try:
                    handle_event(line.decode("utf-8", errors="replace").strip())
                except (OSError, ValueError) as error:
                    print(f"hypr-window-snap: {error}", flush=True)


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError) as error:
        print(f"hypr-window-snap: {error}", flush=True)
        raise
