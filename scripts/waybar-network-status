#!/bin/sh

set -eu

wifi_state=$(nmcli -t -f WIFI radio)
if [ "$wifi_state" != enabled ]; then
    printf '%s\n' "◔ WIFI off"
    exit 0
fi

ssid=$(nmcli -t --escape no -f IN-USE,SSID device wifi list --rescan no |
    awk -F: '$1 == "*" { print $2; exit }')
if [ -n "$ssid" ]; then
    printf '◔ %s\n' "$ssid"
    exit 0
fi

if nmcli -t -f TYPE,STATE device status |
    awk -F: '$1 == "ethernet" && $2 == "connected" { found = 1 } END { exit !found }'; then
    printf '%s\n' "↕ ETH"
    exit 0
fi

printf '%s\n' "× NET"
